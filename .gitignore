.DS_Store

# Secrets — never commit credentials.
# Google Cloud service account keys are usually named like
# `<project>-<key-id>.json` or `*-service-account*.json`.
*service-account*.json
*service_account*.json
neon-reporter-*.json
*.gcp-key.json
gcloud-key*.json

# Local env files (already covered in ss-control-center/.gitignore
# for the Next.js app, but adding here as belt-and-suspenders for
# anyone editing at the repo root).
.env
.env.local
.env.*.local
.vercel
.env*.local

# Confidential business-data exports (COGS / Sellerboard / ChannelMax dumps).
# Accidentally swept into git by the auto-committer — cost/margin data must not
# live in version control. Files stay on disk, just untracked.
docs/*Cost_of_Goods_Sold*.csv
docs/Summary_*.csv
preview-multipack/
tmp-aplus-test/

# Wiki-Brain auto-generated link graph (regenerated by scripts/wiki-brain.mjs
# on every --graph run; would create noisy diffs if committed).
docs/wiki/.brain-graph.json

# >100MB local DB artifacts (GitHub hard limit) — keep local only
ss-control-center/data/walmart-new-sku-engine/rehearsals/
ss-control-center/data/walmart-new-sku-engine/activation/backups/

# release-artifacts (правило от 2026-07-29) ----------------------------------
# ДО этой даты весь каталог был вне git. Следствие: шесть обязательных
# командных путей, на которые ссылались действующие ранбуки как на
# «единственно допустимую команду», физически исчезли вместе с запиненным
# коммитом 78e06649… — целые линии стали неисполнимы.
#
# Разделение: ДОКАЗАТЕЛЬСТВО релиза (манифест + SHA + сертификат + логи, ~7 МБ)
# версионируется. РАБОЧИЕ ДЕРЕВЬЯ движка (4+ ГБ) — нет: они воспроизводятся
# побайтово из запиненного коммита через `git worktree add`.
release-artifacts/**
!release-artifacts/*/
!release-artifacts/*.md
!release-artifacts/*/release-manifest.json
!release-artifacts/*/release-manifest.sha256
!release-artifacts/*/release-certificate.json
!release-artifacts/*/resolution.json
!release-artifacts/*/*.log
.claude/settings.local.json

# Local artifacts — swept into the index by a `git add -A` (cleaned 2026-10-22).
# Files stay on disk, never committed (AGENTS.md §3–4).
ss-control-center/data/audits/
ss-control-center/data/batch200/waves/
ss-control-center/data/batch300/
ss-control-center/data/adjustments-audit/
ss-control-center/data/adjustments_*.json
# Buyer names/messages — customer data, never in git.
ss-control-center/data/customer-hub-owner-replies.json
ss-control-center/.tmp/
ss-control-center/.tmp_*.json
owner-review/walmart-new-sku-preview-gallery/
*.bak-*
# One-off agent handoff notes at the repo root (already tracked ones stay tracked).
/HANDOFF_*.md
/SUMMARY_*.md
# Scratch scripts (tsconfig already excludes them from the build).
ss-control-center/scripts/_*.ts
ss-control-center/data/batch200/
/data/audits/
