00-85acbf9ce75d7b83e1f33aab59dea06a-9d684ffd48c7654e-01","Vary":"Accept-Encoding","X-Ak-Protocol":"h2","X-Akamai-Transformed":"0 - 0 -","X-Edgeconnect-Midmile-Rtt":"0","X-Edgeconnect-Origin-Mex-Latency":"1722","X-Envoy-Upstream-Service-Time":"1550","X-Frame-Options":"SAMEORIGIN","X-Opt-Inj":"true","X-Origin-Stock-Status":"IN_STOCK","X-Oxyserps-Content-Length":"114991","X-Pagebank-Cache-Control":"max-age=-1","X-Tb":"0"}},"content":{"breadcrumbs":[{"category_name":"Food","url":"/cp/food/976759"},{"category_name":"Snacks, Cookies \u0026 Chips","url":"/cp/snacks-cookies-chips/976787"},{"category_name":"Crackers","url":"/cp/crackers/1001392"},{"category_name":"Snack Crackers","url":"/cp/snack-crackers/9358664"}],"cheapest_seller_name":null,"fulfillment":{"delivery":true,"delivery_information":", Delivery, As soon as,  , 38,  , mins","free_shipping":false,"fulfilled_by":"","out_of_stock":false,"pickup":true,"pickup_information":", Pickup, As soon as,  ,  12pm,  , today","shipping":false,"shipping_information":", Shipping, Out of stock"},"general":{"badge":["5K+ bought since yesterday, try a subscription","Overall pick"],"brand":"RITZ","description":"Enjoy a tiny take on the classic RITZ cheese cracker sandwiches you know and love with RITZ Bits Cheese Sandwich Crackers. The bite-sized snacks layer a delicious, cheese spread between two tiny, crispy and flaky RITZ Bits crackers. Made with real cheese and containing no high-fructose corn syrup, these RITZ crackers are convenient lunch snacks, school snacks, and on the go snacks for kids and adults. With RITZ Bits Cheese Sandwich Crackers, you'll be ready for any snacking occasion. RITZ is a Taste of Welcome.\u003cul\u003e  \u003cli\u003eOne 8.8 oz box of RITZ Bits Cheese Sandwich Crackers (packaging may vary)\u003c/li\u003e  \u003cli\u003eSmooth and creamy cheese spread between two tiny RITZ snack crackers\u003c/li\u003e  \u003cli\u003eBite-sized, mini crackers featuring filling made with real cheese and containing no high-fructose corn syrup for a deliciously crunchy snack\u003c/li\u003e  \u003cli\u003eRITZ snack crackers with cheese that make great office snacks and after-school snacks for kids and adults; wonderful on the go snacks and travel snacks\u003c/li\u003e  \u003cli\u003eBox of cheese and crackers for anytime, anywhere snacking\u003c/li\u003e  \u003cli\u003ePackaging may vary. Please refer to the actual packaging for current information for this product\u003c/li\u003e  \u003cli\u003eOur mission at Mondelēz International is to create more moments of joy and build the best snacking company in the world by growing our people, growing our business and growing our impact on the world around us\u003c/li\u003e \u003c/ul\u003e","images":["https://i5.walmartimages.com/seo/RITZ-Bits-Cheese-Sandwich-Crackers-8-8-oz_e02976b4-fba8-4052-9ee8-57443f37b7ec.f2d487fb58a24684014508a2e73b366b.jpeg?odnHeight=117\u0026odnWidth=117\u0026odnBg=FFFFFF","https://images.salsify.com/video/upload/s--7sgfs_mK--/vc_auto,c_limit,h_720,w_720/el92xeac632qzj15rhbt.mp4?odnHeight=117\u0026odnWidth=117\u0026odnBg=FFFFFF","https://i5.walmartimages.com/asr/5825df31-28d1-4b1e-a34d-c3b39d60a2ac.72230d9d074b67159fb0416d1630cfbd.jpeg?odnHeight=117\u0026odnWidth=117\u0026odnBg=FFFFFF","https://i5.walmartimages.com/asr/b499eac0-2fff-4535-a51d-a2dc7b1c1b81.962194b0d37805cc015e86b12bf4d684.jpeg?odnHeight=117\u0026odnWidth=117\u0026odnBg=FFFFFF","https://i5.walmartimages.com/asr/a4c7f7cf-04be-44dd-afee-2ad20a61408a.d4d5d6bc0918a76f767b4b032a07235c.jpeg?odnHeight=117\u0026odnWidth=117\u0026odnBg=FFFFFF","https://i5.walmartimages.com/asr/962a5261-e82c-46a5-9d2c-097e61aa93a9.771e667fd91dae929e9d60d18861b1a2.jpeg?odnHeight=117\u0026odnWidth=117\u0026odnBg=FFFFFF","https://i5.walmartimages.com/asr/45ca99d5-2ba9-45b4-8684-99acce33e30e.46319d49b462713ced23035b5f617baa.jpeg?odnHeight=117\u0026odnWidth=117\u0026odnBg=FFFFFF"],"main_image":"https://i5.walmartimages.com/seo/RITZ-Bits-Cheese-Sandwich-Crackers-8-8-oz_e02976b4-fba8-405