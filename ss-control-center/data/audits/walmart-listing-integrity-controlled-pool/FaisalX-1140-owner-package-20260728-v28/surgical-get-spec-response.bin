itish Columbia BCK","Rabbinical Council Of California","Rabbinical Council Of New England","Rainforest Alliance","RAL Quality Candles","Real California Cheese","Real California Milk","Real Food Seal","Recognized Canadian Dermatology Association Skin Health","Recognized Canadian Dermatology Association Sun Protection","Recupel","Recyclable General Claim","Refined in Canada","REGIONALFENSTER","RHP","Roasted and blended in Canada to describe coffee","Round Table on Responsible Soy","RSB – Roundtable on Sustainable Biomaterials","RT-QuIC","RT-QuIC Tested","Safe Feed Safe Food","Safe Quality Food","Salmon Safe Certification","Schweizer Allergie Gütesiegel","Schweizer Alpprodukt","Schweizer Bergprodukt","SCS Sustainably Grown","SeaChoice","Seedling","SGS Organic","Shopper Army","SKG 1 star","SKG 2 star","SKG 3 star","SKG Certificate","SLG Child Safety","SLG Type Tested","SLK Bio","Society of the Plastics Industry (SPI)","Soil Association Organic Symbol","SOIL Organic Cosmos","SOSTain","Star D Kosher","STAR K Kosher","Steel Recycling","Stellar Certification Services","Stiftung Warentest","Stop Climate Change","Streekproduct.be","Suisse Garantie","Sunshine State Kosher","SUS","Sustainable Forestry Initiative","Sustainable In Practice (SIP)","Sustainable Palm Oil RSPO Certified","Sustainable Palm Oil RSPO Credits","Sustainable Palm Oil RSPO Mixed","Tarnopol Kashrus Kosher","TCO Development","Terra Vitis","The EcoLogo Certification","The Fair Rubber Association","The Natural and Organic Awards","Three Line Kosher","TNO Approved","TOOTHFRIENDLY","Traditional Specialty Guaranteed","Transport Canada National Safety Mark (NSM)","Triangle K Certification","Triman","True Foods Canada Trustmark","True Source Certified","U.S. Department of Agriculture (USDA) – Grade A e.g., eggs","Underwriters laboratory","Underwriters' Laboratory Certified, Canada \"C\" and U.S. US","Uniquely Finnish","United Egg Producers Certified","UNSER Land","USDA","USDA Grade - AA","USDA Inspection","USDA Organic","UTZ Certified","UTZ Certified Cocoa","V Label Vegan","V Label Vegetarian","V.I.V.A.","Vaad Hakashrus of Denver Scroll K Certification","Vaad Hoeir Kosher","Vaelg Fuldkorn Forst","VDE","VDS Certificate","Vegan - VegeCert","Vegan Awareness Foundation","Vegan By Earthkosher","Vegan Natural Food Certifiers","Vegan Society Vegan Logo","Vegaplan","Vegetarian Society - Vegetarian","VEILIG WONEN POLITIE KEURMERK","Vignerons en Développement Durable (VDD)","Water Quality Association (WQA's)- Tested and Certified","WEIDEMELK","Weight Watchers Endorsed","Whole Grain 100 Percent Stamp","Whole Grain Basic Stamp","Whole Grain Council Stamp","Whole grains 50 percent Stamp","WINERIES for Climate Protection (WfCP)","WSDA","WWF Panda Label","Zero Waste Business Council Certified"]},"minItems":1},"prop65WarningText":{"title":"California Prop 65 Warning Text","type":"string","description":"Alphanumeric, 5000 characters - A statement legally required by the state of California for certain items to warn consumers about potential health dangers. See the portions of the California Health and Safety Code related to Proposition 65 to determine which items require labels and to verify the text of your warning label. If a Prop 65 warning is not required, please leave this field blank. Example: This item can expose you to chemicals including [name of one or more chemicals], which is [are] known to the State of California to cause [list associated harm(s) e.g. cancer, birth defects or other reproductive harm, etc.].","examples":["This item can expose you to chemicals including [name of one or more chemicals], which is [are] known to the State of California to cause [list associated harm(s) e.g. cancer, birth defects or other reproductive harm, etc.]."],"comments":"@group=Compliance & Regulatory","minLength":1,"maxLength":5000},"foodAllergenStatements":{"title":"Allergen Statement","type":"string","description":"Alphanumeric, 4000 characters - The statement to the consumer on the presence of allergens, based on local rules or regulations, as stated on the product packaging. Example: Contains Peanuts, Soy, and MSG; Manufactured in a facility that processes tree nuts, milk, and eggs.","examples":["Contains Peanuts, Soy, and MSG","Manufactured in a facility that processes tree nuts, milk, and eggs."],"comments":"@group=Product Content to improve search & browse on Walmart website","minLength":1,"maxLength":4000},"allergens_not_contained":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Allergen-Free Statements","type":"array","description":"Closed List - Statement that identifies any ingredients that are not contained in the food, often written as \"free from\" the ingredient (e.g. Gluten-Free.)","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Allergen-Free Statements","type":"string","description":"Closed List - Statement that identifies any ingredients that are not contained in the food, often written as \"free from\" the ingredient (e.g. Gluten-Free.)","enum":["Casein-Free","Dairy-Free","Egg-Free","Fish-Free","Gluten-Free","Lactose-Free","Milk-Free","Peanut-Free","Shellfish-Free","Soy/Soybean-Free","Tree Nut-Free","Wheat-Free"]},"minItems":1},"assembledProductLength":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Assembled Product Depth","type":"object","description":"Decimal, Value range: 0 to 99999999999999 - The depth of the fully assembled product. NOTE: This information is shown on the item page as length of the product. Example: 5;10;16;22","examples":["5","10","16","22"],"comments":"@group=Product Content to improve search & browse on Walmart website","properties":{"unit":{"title":"Unit","type":"string","description":"Closed List - The depth of the fully assembled product. NOTE: This information is shown on the item page as length of the product.","examples":["5","10","16","22"],"enum":["mm","in","sq ft","cm","ft"]},"measure":{"title":"Measure","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - The depth of the fully assembled product. NOTE: This information is shown on the item page as length of the product. Example: 5;10;16;22","examples":["5","10","16","22"],"minimum":0,"maximum":99999999999999,"multipleOf":0.01}},"required":["unit","measure"],"additionalProperties":false},"assembledProductHeight":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Assembled Product Height","type":"object","description":"Decimal, Value range: 0 to 99999999999999 - The height of the fully assembled product.  Example: 5;10;16;22","examples":["5","10","16","22"],"comments":"@group=Product Content to improve search & browse on Walmart website","properties":{"unit":{"title":"Unit","type":"string","description":"Closed List - The height of the fully assembled product.","examples":["5","10","16","22"],"enum":["mm","in","sq ft","cm","ft"]},"measure":{"title":"Measure","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - The height of the fully assembled product.  Example: 5;10;16;22","examples":["5","10","16","22"],"minimum":0,"maximum":99999999999999,"multipleOf":0.01}},"required":["unit","measure"],"additionalProperties":false},"assembledProductWeight":{"title":"Assembled Product Weight","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - The weight of the fully assembled product.  Example: 1.75;5;12;32","examples":["1.75","5","12","32"],"comments":"@group=Product Content to improve search & browse on Walmart website","minimum":0,"maximum":99999999999999,"multipleOf":0.01},"assembledProductWidth":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Assembled Product Width","type":"object","description":"Decimal, Value range: 0 to 99999999999999 - The width of the fully assembled product.  Example: 5;10;16;22","examples":["5","10","16","22"],"comments":"@group=Product Content to improve search & browse on Walmart website","properties":{"unit":{"title":"Unit","type":"string","description":"Closed List - The width of the fully assembled product.","examples":["5","10","16","22"],"enum":["mm","in","sq ft","cm","ft"]},"measure":{"title":"Measure","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - The width of the fully assembled product.  Example: 5;10;16;22","examples":["5","10","16","22"],"minimum":0,"maximum":99999999999999,"multipleOf":0.01}},"required":["unit","measure"],"additionalProperties":false},"bread_and_bun_type":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Bread & Bun Type","type":"array","description":"Closed List - The style/ form type of the bread or bun","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Bread & Bun Type","type":"string","description":"Closed List - The style/ form type of the bread or bun","enum":["Artisan Bread","Bagel","Baguette","Barm Brack","Batard","Biscuit","Black Bread","Bread Roll","Breadsticks","Brioche","Brown Bread","Bruschetta","Bun","Challah","Chapati","Ciabatta","Cinnamon Bread","Cottage Loaf","Country Bread","Crepe","Crispbread","Crostini","Croutons","Crumpet","Danish Bread","English Muffin","Flatbread","Flute Bread","Focaccia","Forest Corn Loaf","Fougasse","Grey Bread","Hamburger Bun","Hotdog Bun","Injera Bread","Knacke","Matzo Bread","Melba Toast","Milk Bread","Monastery Bread","Muffin","Naan","Papadums","Piadina","Pitta Bread","Plaited Loaf","Potato Bread","Pretzel","Pumpernickel","Round Bread","Rye Bread","Sandwich Bread Loaf","Scone","Soda Bread","Sourdough Bread","Spitz Bread","Stol","Taralli","Teacake","Tigella","Toast Bread","Tortilla","Vanocka Bread","Viennese","Vikorn","White Bread"]},"minItems":1},"container_material":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Container Material","type":"array","description":"Alphanumeric, 50 characters - Material of a product's container, especially for food, health, and beauty products. This is separate from the container's type. Example: Aluminum\nCardboard\nGlass\nPaper\nPlastic","examples":["Aluminum\nCardboard\nGlass\nPaper\nPlastic"],"comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Container Material","type":"string","description":"Alphanumeric, 50 characters - Material of a product's container, especially for food, health, and beauty products. This is separate from the container's type. Example: Aluminum\nCardboard\nGlass\nPaper\nPlastic","minLength":1,"maxLength":50},"minItems":1},"containerType":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Container Type","type":"array","description":"Closed List - The kind of physical package or receptacle that contains the product as presented to the consumer. Also used to describe storage items. Consumers may select different products based on their container preferences.","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Container Type","type":"string","description":"Closed List - The kind of physical package or receptacle that contains the product as presented to the consumer. Also used to describe storage items. Consumers may select different products based on their container preferences.","enum":["Bag","Bowl","Box","Bucket","Can","Carton","Cup","Jar","Packet","Pouch","Tray","Tub","Tube"]},"minItems":1},"countPerPack":{"title":"Count Per Pack","type":"integer","description":"Number, Value range: 0 to 9999999999 - The number of identical items inside each individual package given by the \"Multipack Quantity\" attribute. Examples: (1) A single bottle of 50 pills has a \"Count Per Pack\" of 50. (2) A package containing two identical bottles of 50 pills has a \"Count Per Pack\" of 50. (3) A 6-pack of soda labeled for individual sale connected by plastic rings has a \"Count Per Pack\" of 1. (4) A 6-pack of soda in a box whose cans are not marked for individual sale has a \"Count Per Pack\" of 6. (5) A gift basket of 5 different items has a \"Count Per Pack\" of 1. Example: 1;2;10;50","examples":["1","2","10","50"],"comments":"@group=Product Content to improve search & browse on Walmart website","minimum":0,"maximum":9999999999},"cuisine":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Cuisine","type":"array","description":"Alphanumeric, 30 characters - Indicates the cooking style, especially regional or cultural cuisines, you might use the food to prepare.","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Cuisine","type":"string","description":"Alphanumeric, 30 characters - Indicates the cooking style, especially regional or cultural cuisines, you might use the food to prepare.","minLength":1,"maxLength":30},"minItems":1},"dietaryMethod":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Dietary Method","type":"array","description":"Alphanumeric, 1000 characters - The particular diet groups the product falls under. Example: Atkins;Dash;Ketogenic;Macrobiotic;Paleo;Pescatarian;South Beach;Vegan;Vegetarian;Whole30","examples":["Atkins","Dash","Ketogenic","Macrobiotic","Paleo","Pescatarian","South Beach","Vegan","Vegetarian","Whole30"],"comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Dietary Method","type":"string","description":"Alphanumeric, 1000 characters - The particular diet groups the product falls under. Example: Atkins;Dash;Ketogenic;Macrobiotic;Paleo;Pescatarian;South Beach;Vegan;Vegetarian;Whole30","minLength":1,"maxLength":1000},"minItems":1},"nutrientContentClaims":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Dietary Need","type":"array","description":"Closed List - A claim on a food item that directly or by implication characterizes the level of a nutrient in the food.","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Dietary Need","type":"string","description":"Closed List - A claim on a food item that directly or by implication characterizes the level of a nutrient in the food.","enum":["100 Calorie","100% Whole Grain","Aspartame-Free","Cholesterol-Free","Corn-Free","Fat-Free","Gluten-Free","GMO-Free","Good Source of Calcium","Good Source of Fiber","Good Source of Omega 3 Fatty Acids","Grain-Free","Halal","Half the Fat","High Fiber","High Protein","Iron-Fortified","Kosher","Lactose-Free","Light","Limited Ingredients","Low Calorie","Low Cholesterol","Low Fat","Low Glycemic","Low Salt","Low Sodium","Low Sugar","Low-Carb","Low-Saturated Fat","Made with Simple Ingredients","Multigrain","Natural","No Artificial Colors","No Artificial Flavors","No Artificial Ingredients","No Artificial Preservatives","No Artificial Sweeteners","No Carbohydrates","No High-Fructose Corn Syrup","No MSG","No Preservatives","No Sugar Added","Nonfat","Nut-Free","Organic","Reduced Sugar","Salt-Free","Sodium-Free","Specialty","Sugar-Free","Trans Fat-Free","Vegan","Vegetarian","Wheat-Free","Yeast-Free","Zero Calorie"]},"minItems":1},"flavor":{"title":"Flavor","type":"string","description":"Alphanumeric, 600 characters - The distinctive taste or flavor of the item, as provided by manufacturer.  Example: Unflavored\nSweet Hawaiian\nSweet Onion\nButtery\nCinnamon & Raisin\nCinnamon Roll","examples":["Unflavored\nSweet Hawaiian\nSweet Onion\nButtery\nCinnamon & Raisin\nCinnamon Roll"],"comments":"@group=Product Content to improve search & browse on Walmart website","minLength":1,"maxLength":600},"food_condition":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Food Condition","type":"array","description":"Closed List - Describes the overall condition of the food at the point of purchase- whether it is cooked or raw, fresh or frozen or shelf-stable, etc.","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Food Condition","type":"string","description":"Closed List - Describes the overall condition of the food at the point of purchase- whether it is cooked or raw, fresh or frozen or shelf-stable, etc.","enum":["Frozen","Refrigerated","Shelf-Stable"]},"minItems":1},"foodForm":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Food Form","type":"array","description":"Closed List - Describes the form of the food, as it exists in the package.  If the food is sold in a variety of forms, such as sliced and unsliced, whole or halves, etc.","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Food Form","type":"string","description":"Closed List - Describes the form of the food, as it exists in the package.  If the food is sold in a variety of forms, such as sliced and unsliced, whole or halves, etc.","enum":["Balls","Bars","Bites","Cakes","Chopped","Clusters","Crumbles","Cups","Curls","Ground","Knots","Liquids","Patties","Pieces","Puffs","Rods","Rolls","Rounds","Semi-Solid Liquids","Spirals","Squares","Sticks","Straws","Strings","Strips","Twists","Whole"]},"minItems":1},"grain_type":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Grain Type","type":"array","description":"Closed List - Identifies the small, hard, dry seed with or without an attached hull or fruit layer.","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Grain Type","type":"string","description":"Closed List - Identifies the small, hard, dry seed with or without an attached hull or fruit layer.","enum":["Barley","Bran","Combination","Common Wheat","Corn","Durum Wheat","Kamut","Maize","Mixed Grain","Oat","Poppy Seed","Rice","Rye","Rye Full Grain","Sesame Wheat","Soft Wheat","Soy Flour","Spelt","Wheat","Wheatgerm","White Wheat","Whole Grain","Whole Wheat","Wholemeal"]},"minItems":1},"production_method_type":{"title":"In-Store Production Method Type","type":"string","description":"Closed List - Method by which Items can be tracked in a BOM.","comments":"@group=Product Content to improve search & browse on Walmart website","enum":["Made to Order","Made to Stock","Thaw & Sell","Vendor Dated"]},"ingredientListImage":{"title":"Ingredient List Image","type":"string","description":"URL, 2500 characters - If your product contains a list of ingredients OTHER than that required with drug, supplement, or nutrition info, provide the URL of image. Provide the final destination image URL (no-redirects) that is publicly accessible (no username/password required) and ends in a proper image extension. Recommended file type: JPEG Accepted file types: JPG, PNG, BMP Maximum file size: 5 MB. Example: http://www.somedomain.com/somepath/some-image.jpg","examples":["http://www.somedomain.com/somepath/some-image.jpg"],"comments":"@group=Product Content to improve search & browse on Walmart website","minLength":1,"maxLength":2500,"format":"uri"},"ingredients":{"title":"Ingredients Statement","type":"string","description":"Alphanumeric, 5000 characters - The list of all ingredients contained in an item, as found on the product label mandated by FDA guidelines. The ingredients should be listed in descending order by weight. The label must list the names of any FDA-certified color additives, but some ingredients can be listed collectively as flavors, spices, artificial flavoring or artificial colors. Refer to the FDA Food Labeling Guide for more guidelines.   Example: Whole Grain Oats, Cane Sugar, Rice, Sunflower Oil, Honey, Molasses, Sea Salt, Natural Flavor. Vitamin E (mixed tocopherols) Added to Preserve Freshness.","examples":["Whole Grain Oats, Cane Sugar, Rice, Sunflower Oil, Honey, Molasses, Sea Salt, Natural Flavor. Vitamin E (mixed tocopherols) Added to Preserve Freshness."],"comments":"@group=Product Content to improve search & browse on Walmart website","minLength":1,"maxLength":5000},"isProp65WarningRequired":{"title":"Is Prop 65 Warning Required","type":"string","description":"Closed List - Prop 65 requires warning statements for items that contain chemicals known to the state of California to cause cancer, birth defects or other reproductive harm if certain criteria are met (such as quantity of chemical contained in the item). You must add the exact warning content to the field \"California Prop 65 Warning Text.\" See the portions of the California Health and Safety Code related to Proposition 65 for more information.","comments":"@group=Product Content to improve search & browse on Walmart website","enum":["No","Yes"]},"shelfLife":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Minimum Days of Shelf Life from Production","type":"object","description":"Number, Value range: 0 to 9999 - The seller's determination of the minimum number of calendar days from the production date to the expiration date. Example: 180;220","examples":["180","220"],"comments":"@group=Product Content to improve search & browse on Walmart website","properties":{"unit":{"title":"Unit","type":"string","description":"Closed List - The seller's determination of the minimum number of calendar days from the production date to the expiration date.","examples":["180","220"],"enum":["months","days","years"]},"measure":{"title":"Measure","type":"integer","description":"Number, Value range: 0 to 9999 - The seller's determination of the minimum number of calendar days from the production date to the expiration date. Example: 180;220","examples":["180","220"],"minimum":0,"maximum":9999}},"required":["unit","measure"],"additionalProperties":false},"multipackQuantity":{"title":"Multipack Quantity","type":"integer","description":"Number, Value range: 0 to 9999 - The number of identical, individually packaged-for-sale items. If an item does not contain other items, does not contain identical items, or if the items contained within cannot be sold individually, the value for this attribute should be\"1.\" Examples: (1) A single bottle of 50 pills has a \"Multipack Quantity\" of\"1.\" (2) A package containing two identical bottles of 50 pills has a \"Multipack Quantity\" of 2. (3) A 6-pack of soda labelled for individual sale connected by plastic rings has a \"Multipack Quantity\" of\"6.\" (4) A 6-pack of soda in a box whose cans are not marked for individual sale has a \"Multipack Quantity\" of\"1.\" (5) A gift basket of 5 different items has a \"Multipack Quantity\" of\"1.\" Example: 1;2;4;6","examples":["1","2","4","6"],"comments":"@group=Product Content to improve search & browse on Walmart website","minimum":0,"maximum":9999},"netContent":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Net Content","type":"object","description":"The quantity (or quantities) of the product contained in the package along with its unit of measure typically printed on the label for the country or market where the product is sold.  For example, a gallon of milk has 128 Fluid Ounces: Measure = 128 and Units = Fluid Ounces. \n\nPlease Note: If your item includes multiple items with the same UOM, add them together to get the total measurement. If the item is a set with multiple items that do not share the same UOM, list as 1 Each.","comments":"@group=Product Content to improve search & browse on Walmart website","properties":{"productNetContentUnit":{"title":"Unit","type":"string","description":"Closed List - The unit of weight or volume on the item packaging. For example, a gallon of milk has 128 fluid ounces: Unit = fluid ounces. \nIf your item has multiple components that use the same unit of weight or volume, add them together to get the total measurement. If components don't share the same unit, select \"Each\" as the unit and \"1\" as the measure. For example, a box of 6 coffee pods each weighing 5.3 oz:Unit=ounces","enum":["Centiliter","Count","Each","Fluid Ounces","Gallon","Gram","Kilogram","Liter","Milliliter","Ounce","Pint","Pound","Quart","Quart Dry"]},"productNetContentMeasure":{"title":"Measure","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - The numeric value of weight or volume that appears on the item packaging. For example, a gallon of milk has 128 fluid ounces:\nMeasure = 128\nIf your item has multiple components that use the same unit, add them together to get the total measurement. If components don't share the same unit, select \"Each\" as the unit and \"1\" as the measure. Example: 1;12;32","examples":["1","12","32"],"minimum":0,"maximum":99999999999999,"multipleOf":0.001}},"required":["productNetContentUnit","productNetContentMeasure"],"additionalProperties":false},"netContentStatement":{"title":"Net Content Statement","type":"string","description":"Alphanumeric, 500 characters - Complete product net content statement, as it appears on product packaging. Example: 6 - 5.3 OZ (150g) CUPS;1.98 Lb (900g)","examples":["6 - 5.3 OZ (150g) CUPS","1.98 Lb (900g)"],"comments":"@group=Product Content to improve search & browse on Walmart website","minLength":1,"maxLength":500},"pieceCount":{"title":"Number of Pieces","type":"integer","description":"Number, Value range: 0 to 99999999999999 - The number of small pieces, slices, or different items within the product. Piece Count applies to things such as puzzles, building block sets, and products that contain multiple different items (such as tool sets, dinnerware sets, gift baskets, art sets, makeup kits, or shaving kits.) Examples: A gift basket of 5 different items has a “Piece Count” of 5.; A 105-Piece Socket Wrench set has a \"Piece Count\" of 105.; A 500-piece puzzle has a “Piece Count” of 500. Example: 5;105;500","examples":["5","105","500"],"comments":"@group=Product Content to improve search & browse on Walmart website","minimum":0,"maximum":99999999999999},"nutrients":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Nutrients","type":"array","description":"Additional nutrients, not including total fat or total carbohydrates, which should be entered in\"Total Fat\" and\"Total Carbohydrate\" respectively. Example: sample nutrients","examples":["sample nutrients"],"comments":"@group=Product Content to improve search & browse on Walmart website","items":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Nutrients","type":"object","description":"Additional nutrients, not including total fat or total carbohydrates, which should be entered in\"Total Fat\" and\"Total Carbohydrate\" respectively. Example: sample nutrients","properties":{"nutrientAmount":{"title":"Amount","type":"string","description":"Alphanumeric, 400 characters - Amount of the nutrient present in one serving. This attribute is used in conjunction with Nutrient Name and Nutrient Percentage Daily Value.  Example: 30 g;30 mg","examples":["30 g","30 mg"],"minLength":1,"maxLength":400},"nutrientName":{"title":"Name","type":"string","description":"Alphanumeric, 4000 characters - Name of additional nutrient. This attribute is used in conjunction with Nutrient Amount and Nutrient Percentage Daily Value. Example: Vitamin A;Dietary Fiber","examples":["Vitamin A","Dietary Fiber"],"minLength":1,"maxLength":4000},"nutrientPercentageDailyValue":{"title":"Percentage Daily Value","type":"string","description":"Alphanumeric, 20 characters - Percent daily value of the nutrient present in one serving. This attribute is used in conjunction with Nutrient Name and Nutrient Amount. Example: 15%;25%","examples":["15%","25%"],"minLength":1,"maxLength":20}},"additionalProperties":false},"minItems":1},"nutritionFactsLabel":{"title":"Nutrition Facts Label Image","type":"string","description":"URL, 2500 characters - Image URL of the nutritional facts label. Provide the final destination image URL (no-redirects) that is publicly accessible (no username/password required) and ends in a proper image extension. Recommended file type: JPEG. Maximum file size: 5 MB. Example: http://www.somedomain.com/filelocation/image.jpg","examples":["http://www.somedomain.com/filelocation/image.jpg"],"comments":"@group=Product Content to improve search & browse on Walmart website","minLength":1,"maxLength":2500,"format":"uri"},"food_and_drug_fact_label_type":{"title":"Nutrition/Supplement/Drug Label Type","type":"string","description":"Closed List - If the item contains Supplement Facts, Drug Facts or Nutrition Facts, please make the appropriate selection. If the product does not contain any of the three listed fact panels OR contains only a fact panel other than the three listed, then select None.","comments":"@group=Product Content to improve search & browse on Walmart website","enum":["Drug Fact Panel","No Fact Panel","Nutrition Fact Panel","Supplement Fact Panel"]},"occasion":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Occasion","type":"array","description":"Alphanumeric, 2000 characters - The particular target time, event, or holiday for the product. Example: All Occasion;Everyday;Back to School;Christmas;Easter;Valentine's Day;Halloween;Hanukkah;Thanksgiving;New Year;Weddings;Anniversary;Graduation;Baby Shower;Bachelor Party;Bachelorette Party;Bridal Occasion;Bridal Shower;Casual;Retirement;Thank You","examples":["All Occasion","Everyday","Back to School","Christmas","Easter","Valentine's Day","Halloween","Hanukkah","Thanksgiving","New Year","Weddings","Anniversary","Graduation","Baby Shower","Bachelor Party","Bachelorette Party","Bridal Occasion","Bridal Shower","Casual","Retirement","Thank You"],"comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Occasion","type":"string","description":"Alphanumeric, 2000 characters - The particular target time, event, or holiday for the product. Example: All Occasion;Everyday;Back to School;Christmas;Easter;Valentine's Day;Halloween;Hanukkah;Thanksgiving;New Year;Weddings;Anniversary;Graduation;Baby Shower;Bachelor Party;Bachelorette Party;Bridal Occasion;Bridal Shower;Casual;Retirement;Thank You","minLength":1,"maxLength":2000},"minItems":1},"food_preparation_method":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Preparation Type","type":"array","description":"Closed List - The method in how the manufacturer prepared or cooked the food prior to packaging the product. - i.e. stewed, smoked, fried, etc.","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Preparation Type","type":"string","description":"Closed List - The method in how the manufacturer prepared or cooked the food prior to packaging the product. - i.e. stewed, smoked, fried, etc.","enum":["Air Fried","Baked","Dipped","Fried","Glazed","Kettle Cooked","Stuffed","Thawed","Toasted","Whipped"]},"minItems":1},"productLine":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Product Line","type":"array","description":"Alphanumeric, 400 characters - Product lines exist as a sub-structure of brands and, frequently, as a super-structure of models.","comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Product Line","type":"string","description":"Alphanumeric, 400 characters - Product lines exist as a sub-structure of brands and, frequently, as a super-structure of models.","minLength":1,"maxLength":400},"minItems":1},"ib_retail_packaging":{"title":"Retail Packaging","type":"string","description":"Closed List - Descriptive terms for the way a product is packaged for sale to the customer.","comments":"@group=Product Content to improve search & browse on Walmart website","enum":["Bundle","Combo Pack","Gift Set","Sampler Set","Value Pack","Variety Pack"]},"size":{"title":"Size","type":"string","description":"Alphanumeric, 500 characters - Overall dimensions of an item. Used only for products that do not already have a more specific attribute, such as ring size, clothing size, and bottled pen ink. Example: 5 oz;250 g;12 fl oz; 10 oz","examples":["5 oz","250 g","12 fl oz","10 oz"],"comments":"@group=Product Content to improve search & browse on Walmart website","minLength":1,"maxLength":500},"sizeDescriptor":{"title":"Size Descriptor","type":"string","description":"Closed List - General descriptors related to product sizes.","comments":"@group=Product Content to improve search & browse on Walmart website","enum":["Full","Giant","Mini","Regular","Thin"]},"texture":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Texture","type":"array","description":"Alphanumeric, 100 characters - The feel, appearance, or consistency of the item. Example: Chewy;Creamy;Crispy;Crunchy;Dense;Firm;Fluffy;Gummy;Hard;Lite;Soft;Sticky;Thick;Whipped","examples":["Chewy","Creamy","Crispy","Crunchy","Dense","Firm","Fluffy","Gummy","Hard","Lite","Soft","Sticky","Thick","Whipped"],"comments":"@group=Product Content to improve search & browse on Walmart website","items":{"title":"Texture","type":"string","description":"Alphanumeric, 100 characters - The feel, appearance, or consistency of the item. Example: Chewy;Creamy;Crispy;Crunchy;Dense;Firm;Fluffy;Gummy;Hard;Lite;Soft;Sticky;Thick;Whipped","minLength":1,"maxLength":100},"minItems":1},"theme":{"title":"Theme","type":"string","description":"Alphanumeric, 800 characters - A dominant idea, meaning, or setting applied to an item.  Example: Beach;New York City;Religious;Retro;Love;Be Kind;Princesses;Animal;Space;Hollywood;Magic;Jungle;Unicorns;Desert;Carnival;Hawaiian;Multi-theme","examples":["Beach","New York City","Religious","Retro","Love","Be Kind","Princesses","Animal","Space","Hollywood","Magic","Jungle","Unicorns","Desert","Carnival","Hawaiian","Multi-theme"],"comments":"@group=Product Content to improve search & browse on Walmart website","minLength":1,"maxLength":800},"count":{"title":"Total Count","type":"integer","description":"Number, Value range: 0 to 99999999999999 - The total number of identical items in the package or box; a result of the multiplication of Multipack Quantity by Count Per Pack. Examples: (1) A single bottle of 50 pills has a \"Total Count\" of 50. (2) A package containing two identical bottles of 50 pills has a \"Total Count\" of 100. (3) A gift basket of 5 different items has a \"Total Count\" of 1. Example: 1;50;100","examples":["1","50","100"],"comments":"@group=Product Content to improve search & browse on Walmart website","minimum":0,"maximum":99999999999999}},"additionalProperties":false}}},"Orderable":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","allOf":[{"if":{"anyOf":[{"properties":{"IsPreorder":{"type":"string","enum":["Yes"]}},"required":["IsPreorder"]}]},"then":{"required":["releaseDate"]}}],"properties":{"sku":{"title":"SKU","type":"string","description":"Alphanumeric, 50 characters - The letters and/or numbers a partner uses to identify an item. Walmart includes this value in all communications regarding item information such as orders. Example: TRVAL28726","examples":["TRVAL28726"],"comments":"@group=Headers","minLength":1,"maxLength":50},"productIdentifiers":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Product Identifiers","type":"object","description":"Specify at least one Product ID and its ID Type.","comments":"@group=Product Identifiers","properties":{"productId":{"title":"Product ID","type":"string","description":"Alphanumeric, 14 characters - Provide the GTIN that identifies the product's consumable (selling) unit. Expand the GTIN to 14 digits by adding preceding zeroes and check digit. A GTIN (Global Trade Item Number) is used to identify an item at any point in the Supply Chain. A GTIN refers to the data structure (not symbology) used to identify the scannable item, case, inner pack (i.e., break pack) or pallet that make up the hierarchy. Example: 00123456781011","examples":["00123456781011"],"minLength":1,"maxLength":14},"productIdType":{"title":"Product ID Type","type":"string","description":"Closed List - Unique numbers used to tell items apart.\n\nUPC (Universal Product Code): 12-digit code.\nEAN (European Article Number): 13-digit code.\nGTIN (Global Trade Item Number): 14 digits code.\nISBN (International Standard Book Number): Code is used specifically for books (either 10 or 13 digits).","enum":["EAN","GTIN","ISBN","UPC"]}},"required":["productId","productIdType"],"additionalProperties":false},"externalProductIdentifier":{"$schema":"http://json-schema.org/draft-07/schema#","title":"External Product Identifier","type":"array","description":"Closed List - Optional. Specify External Product Identifier and its ID Type if available.","comments":"@group=Basic Item Info","items":{"$schema":"http://json-schema.org/draft-07/schema#","title":"External Product Identifier","type":"object","description":"Closed List - Optional. Specify External Product Identifier and its ID Type if available.","properties":{"externalProductIdType":{"title":"External Product ID Type","type":"string","description":"Closed List - ASIN is the Amazon Standard Identification Number. It's a unique 10-digit sequence of letters and/or numbers.","enum":["ASIN"]},"externalProductId":{"title":"External Product ID","type":"string","description":"Alphanumeric, 10 characters - ASIN for your item Example: B002Z36VJE","examples":["B002Z36VJE"],"minLength":1,"maxLength":10}},"required":["externalProductIdType","externalProductId"],"additionalProperties":false},"minItems":1},"IsPreorder":{"title":"Is Preorder","type":"string","description":"Closed List - Indicates if this item is available for preorder. Additional information will need to be provided to properly set up the preorder including Release Date. Is Preorder = Yes is REQUIRED for setting up an item as a preorder.","comments":"@group=Site Experience","enum":["No","Yes"]},"releaseDate":{"title":"Release Date","type":"string","description":"Date, Provide the date that the item will be released to the public by the manufacturer. Release Date is REQUIRED for setting up an item as a preorder.  Example: yyyy-mm-dd Example: 2016-01-20","examples":["2016-01-20"],"comments":"@group=Site Experience","format":"date-time"},"startDate":{"title":"Site Start Date","type":"string","description":"DateTime, Indicates the date and time (UTC) when the item will be published on site. For preorders, this will be the date and time when the item can be Preordered by a customer. Enter hours based on military time (24-hour window, e.g. For 8PM, it will be 20 in hours) Example: yyyy-mm-dd  hh : mm : ss","examples":["yyyy-mm-dd  hh : mm : ss"],"comments":"@group=Site Experience","format":"date-time"},"endDate":{"title":"Site End Date","type":"string","description":"Date, Indicates the date when the partner's item should be removed from the site. Example: yyyy-mm-dd","examples":["yyyy-mm-dd"],"comments":"@group=Site Experience","format":"date-time"},"removeVariantGroup":{"title":"Remove from Variant Group?","type":"string","description":"Closed List - Indicates that a variant(s) should be removed from a variant group offering.","comments":"@group=Site Experience","enum":["No","Yes"]},"bundle_component_transactable":{"title":"Bundle Component Transactable","type":"string","description":"Closed List - Attribute allows seller to indicate whether a component that is part of a virtual pack (or other bundles) can continue to be made available on the website to sell - this indicates the scenario where the component can be made not available but its virtual pack (or non config in the future) can continue to sell","comments":"@group=Site Experience","enum":["No","Yes"]},"stateRestrictions":{"$schema":"http://json-schema.org/draft-07/schema#","title":"State Restrictions","type":"array","description":"Group of attributes to capture information when there are restrictions (legal or supplier discretion) prohibiting an item's sale.","comments":"@group=Compliance & Regulatory","items":{"$schema":"http://json-schema.org/draft-07/schema#","title":"State Restrictions","type":"object","description":"Group of attributes to capture information when there are restrictions (legal or supplier discretion) prohibiting an item's sale.","properties":{"stateRestrictionsText":{"title":"State Restrictions Reason","type":"string","description":"Closed List - The reason an item is restricted or prohibited from being sold in one or more states or zip codes. If your item doesn't have any restrictions, select \"None.\"","enum":["Commercial","Illegal for Sale","None"]},"zipCodes":{"title":"ZIP Codes","type":"string","description":"Alphanumeric, 100000 characters - The postal codes in which an item is restricted or prohibited from being sold. This may also include zip codes where you prefer not to sell the item. It's your obligation to research the all laws (Federal, State, Local) that impact your product and to indicate to Walmart the required state postal code sale restrictions. If the full state is restricted, please use the States attribute. Example: 94085, 94086, 94087, 72712, 72716","examples":["94085, 94086, 94087, 72712, 72716"],"minLength":1,"maxLength":100000},"states":{"title":"States","type":"string","description":"Closed List - The full list of states in which the item is restricted or prohibited from being sold. This may also include states where you prefer not to sell the item. It's your obligation to research all laws (Federal, State, Local) that impact your product and to indicate to Walmart the required state sale restrictions.","enum":["AK - Alaska","AL - Alabama","AR - Arkansas","AS - American Samoa","AZ - Arizona","CA - California","CO - Colorado","CT - Connecticut","DC - District of Columbia","DE - Delaware","FL - Florida","FM - Federated States of Micronesia","GA - Georgia","GU - Guam","HI - Hawaii","IA - Iowa","ID - Idaho","IL - Illinois","IN - Indiana","KS - Kansas","KY - Kentucky","LA - Louisiana","MA - Massachusetts","MD - Maryland","ME - Maine","MH - Marshall Islands","MI - Michigan","MN - Minnesota","MO - Missouri","MP - Commonwealth of the Northern Mariana Islands","MS - Mississippi","MT - Montana","NC - North Carolina","ND - North Dakota","NE - Nebraska","NH - New Hampshire","NJ - New Jersey","NM - New Mexico","NV - Nevada","NY - New York","OH - Ohio","OK - Oklahoma","OR - Oregon","PA - Pennsylvania","PR - Puerto Rico","PW - Palau","RI - Rhode Island","SC - South Carolina","SD - South Dakota","TN - Tennessee","TX - Texas","UM - U.S. Minor Outlying Islands","UT - Utah","VA - Virginia","VI - U.S. Virgin Islands","VT - Vermont","WA - Washington","WI - Wisconsin","WV - West Virginia","WY - Wyoming"]}},"additionalProperties":false},"minItems":1},"country_of_origin_substantial_transformation":{"title":"Country of Origin - Substantial Transformation","type":"string","description":"Closed List - The country where the item and/or its components are manufactured, produced, or grown.","comments":"@group=Compliance & Regulatory","enum":["Afghanistan","Aland Islands","Albania","Algeria","American Samoa","Andorra","Angola","Anguilla","Antarctica","Antigua and Barbuda","Argentina","Armenia","Aruba","Australia","Austria","Azerbaijan","Bahamas","Bahrain","Bangladesh","Barbados","Belarus","Belgium","Belize","Benin","Bermuda","Bhutan","Bolivia","Bonaire","Bosnia and Herzegovina","Botswana","Bouvet Island","Brazil","British Indian Ocean Territory","Brunei Darussalam","Bulgaria","Burkina Faso","Burundi","Cambodia","Cameroon","Canada","Cape Verde","Cayman Islands","Central African Republic","Chad","Chile","China","Christmas Island","Cocos (Keeling) Islands","Colombia","Comoros","Cook Islands","Costa Rica","Cote d Ivoire","Croatia","Cuba","Curacao","Cyprus","Czech Republic","Democratic Republic of the Congo","Denmark","Djibouti","Dominica","Dominican Republic","Ecuador","Egypt","El Salvador","Equatorial Guinea","Eritrea","Estonia","Eswatini","Ethiopia","Falkland Islands (Malvinas)","Faroe Islands","Fiji","Finland","France","French Guiana","French Polynesia","French Southern Territories","Gabon","Gambia","Georgia","Germany","Ghana","Gibraltar","Greece","Greenland","Grenada","Guadeloupe","Guam","Guatemala","Guernsey","Guinea","Guinea-Bissau","Guyana","Haiti","Heard Island & McDonald Isl","Honduras","Hong Kong","Hungary","Iceland","India","Indonesia","Iran","Iraq","Ireland","Isle of Man","Israel","Italy","Jamaica","Japan","Jersey","Jordan","Kazakhstan","Kenya","Kiribati","Korea, North","Korea, South","Kosovo","Kuwait","Kyrgyzstan","Laos","Latvia","Lebanon","Lesotho","Liberia","Libyan Arab Jamahiriya","Liechtenstein","Lithuania","Luxembourg","Macau","Macedonia","Madagascar","Malawi","Malaysia","Maldives","Mali","Malta","Marshall Islands","Martinique","Mauritania","Mauritius","Mayotte","Mexico","Micronesia","Moldova","Monaco","Mongolia","Montenegro","Montserrat","Morocco","Mozambique","Myanmar","Namibia","Nauru","Nepal","Netherlands","New Caledonia","New Zealand","Nicaragua","Niger","Nigeria","Niue","Norfolk Island","Northern Mariana Islands","Norway","Oman","Pakistan","Palau","Palestine","Panama","Papua New Guinea","Paraguay","Peru","Philippines","Pitcairn","Poland","Portugal","Puerto Rico","Qatar","Republic of the Congo","Reunion","Romania","Russian Federation","Rwanda","Saint Barthelemy","Saint Helena","Saint Kitts And Nevis","Saint Lucia","Saint Maarten","Saint Martin","Saint Pierre And Miquelon","Saint Vincent & the Grenadines","Samoa","San Marino","Sao Tome and Principe","Saudi Arabia","Senegal","Serbia","Seychelles","Sierra Leone","Singapore","Slovakia","Slovenia","Solomon Islands","Somalia","South Africa","South Georgia/So Sandwich Isl","South Sudan","Spain","Sri Lanka","Sudan","Suriname","Svalbard and Jan Mayen","Sweden","Switzerland","Syrian Arab Republic","Taiwan","Tajikistan","Tanzania","Thailand","Timor-Leste","Togo","Tokelau","Tonga","Trinidad and Tobago","Tunisia","Turkey","Turkmenistan","Turks and Caicos Islands","Tuvalu","Uganda","Ukraine","United Arab Emirates","United Kingdom","United States","Uruguay","US Minor Outlying Islands","Uzbekistan","Vanuatu","Vatican City State","Venezuela","Viet Nam","Virgin Islands (British)","Virgin Islands (U.S.)","Wallis and Futuna Islands","Western Sahara","Yemen","Zambia","Zimbabwe"]},"price":{"title":"Selling Price","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - The price a customer pays for the item. Do not use commas or currency symbols Example: 100.33","examples":["100.33"],"comments":"@group=Pricing","minimum":0,"maximum":99999999999999,"multipleOf":0.01},"msrp":{"title":"MSRP","type":"number","description":"Decimal, Value range: 0 to 99999999 - Manufacturer's suggested retail price. This is not the price that Walmart customers will pay for your product. You can use up to 8 digits before the decimal place. Do not use commas or dollar signs. Example: 19.95","examples":["19.95"],"comments":"@group=Pricing","minimum":0,"maximum":99999999,"multipleOf":0.01},"automate_pricing":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Automate Pricing","type":"object","description":"","comments":"@group=Pricing","properties":{"minimumSellerAllowedPrice":{"title":"Minimum Seller Allowed Price","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - Your offer's floor/lowest price at which you are willing to sell it for. You must set a valid minimum seller allowed price for repricer to take action. Note: The Repricer will not overwrite existing MAP price rules applied through the Price & Promotions Spec. Example: 23.99","minimum":0,"maximum":99999999999999,"multipleOf":0.01},"maximumSellerAllowedPrice":{"title":"Maximum Seller Allowed Price","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - Your offer's ceiling/highest price at which you are willing to sell it for. You must set a valid maximum seller allowed price for repricer to take action. Example: 49.99","minimum":0,"maximum":99999999999999,"multipleOf":0.01},"repricerStrategy":{"title":"Repricer Strategy","type":"string","description":"Alphanumeric, 75 characters - Prepopulated list of exisiting repricer strategies name that a seller has setup. The Repricing strategy that you wish to assign to your items. Select from the drop-down or copy and paste the Strategy Name from the Repricer page in Seller Center. This field is case and space sensitive - please ensure that the name matches exactly as it appears on the Repricer page. Select \"No Strategy/Delete from Repricer\" to remove your items from a currently mapped strategy.","minLength":0,"maxLength":75}},"additionalProperties":false},"businessPrice":{"title":"Business Price","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - The price the business customers pay for the product.","comments":"@group=Pricing","minimum":0,"maximum":99999999999999,"multipleOf":0.01},"shipsInOriginalPackaging":{"title":"Ships in Original Packaging","type":"string","description":"Closed List - Can this product be shipped in the original packaging without being put in an outer box? Notes: 1) This is to indicate whether it's *possible* for the item to be shipped in original box, not whether it is required. 2) This was previously known as\"Ships As-Is.\"","comments":"@group=Logistics & Transportation","enum":["No","Yes"]},"MustShipAlone":{"title":"Must ship alone?","type":"string","description":"Closed List - Select \"Yes\" if your item cannot ship with another item in the same box. If marked \"Yes,\" the ship alone item will not be grouped for ship price calculation.","comments":"@group=Logistics & Transportation","enum":["No","Yes"]},"ShippingWeight":{"title":"Shipping Weight (lbs)","type":"number","description":"Decimal, Value range: 0 to 99999999999999 - The weight  including all of its packaging materials. Example: 5","examples":["5"],"comments":"@group=Logistics & Transportation","minimum":0,"maximum":99999999999999,"multipleOf":0.001},"fulfillmentLagTime":{"title":"Fulfillment Lag Time","type":"integer","description":"Number, Value range: 0 to 99 - Fulfillment Lag time of 0 days is suggested to improve TwoDay Delivery eligibility and customer conversion rates. Fulfillment Lag Time determines the number of days it takes the Seller to prepare an order for shipment. The default value is 0 if no entry is provided. In order to input a value of 2 days or more, you need to be approved for a Lag Time Exemption.","comments":"@group=Logistics & Transportation","minimum":0,"maximum":99},"product_package_dimensions_and_weight":{"$schema":"http://json-schema.org/draft-07/schema#","title":"Product Package Dimensions and Weight","type":"object","description":"999999999 characters - The collective measurements of a product’s packaging, including its height, width, and depth","comments":"@group=Logistics & Transportation","properties":{"product_package_dimensions_depth":{"title":"Product Package Dimensions Depth (in)","type":"number","description":"Decimal, Value range: 0 to 999999999 - The measurement of the product package from front to back, taken with the package resting on its natural base and oriented facing forward.","minimum":0,"maximum":999999999,"multipleOf":1.0E-4},"product_package_weight":{"title":"Product Package Weight (lbs)","type":"number","description":"Decimal, Value range: 0 to 999999999 - The weight of the  packaged product.","minimum":0,"maximum":999999999,"multipleOf":1.0E-4},"product_package_dimensions_height":{"title":"Product Package Dimensions Height (in)","type":"number","description":"Decimal, Value range: 0 to 999999999 - The vertical measurement of the product package from top to bottom, with the package positioned on its natural base and facing forward.","minimum":0,"maximum":999999999,"multipleOf":1.0E-4},"product_package_dimensions_width":{"title":"Product Package Dimensions Width (in)","type":"number","description":"Decimal, Value range: 0 to 999999999 - The shortest horizontal measurement of the product package from left to right, with the package placed on its natural base and facing forward.","minimum":0,"maximum":999999999,"multipleOf":1.0E-4}},"additionalProperties":false}},"required":["sku","productIdentifiers"],"additionalProperties":false}},"required":[]}}},"title":"MPItemFeed","required":["MPItemFeedHeader","MPItem"],"additionalProperties":false}}